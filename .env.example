# Copy this file to .env (or .env.development) and fill in your own values.
# The community shell needs its own backend project — create one at
# https://lovable.dev (Lovable Cloud) or plug any Supabase-compatible host.

# --- Supabase / Lovable Cloud -----------------------------------------------
# The client throws until these are set. Auth, the store catalogue and
# licence checks need them; the CB deck itself runs without them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-side only (never expose to the browser):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (only if you run the store) -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Everything else the shell reads is optional and feature-gated; unset
# variables degrade the related screen instead of breaking the app.
